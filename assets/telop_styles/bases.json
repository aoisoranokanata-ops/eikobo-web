             "line_spacing": 0.15, "anchor": "bottom_left", "margin_x": 120, "margin_y": 140}},

  {"id": "news_flash", "name": "速報風の帯（左上）", "category": "情報・ニュース", "tags": ["帯", "速報", "左上"],
