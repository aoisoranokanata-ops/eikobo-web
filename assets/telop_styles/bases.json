{
 "schema": 1,
 "comment": "映工房のテロップスタイルのベース設計（すべて映工房の独自設計）。\"$名前\" は palettes.json の配色の値に置き換わる。px は 1080p 基準。",
 "bases": [
  {"id": "basic_edge", "name": "基本の縁取り", "category": "基本", "tags": ["定番", "縁取り"],
   "fonts": ["BIZ UDGothic", "Noto Sans JP", "Yu Gothic", "Meiryo"],
   "palettes": ["white", "yellow", "cyan", "pink", "green"],
   "style": {"size": 96, "weight": 700, "color": "$fill", "strokes": [{"width": 8, "color": "$edge"}],
