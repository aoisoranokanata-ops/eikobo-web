             "shadow": {"color": "$fill", "dx": 0, "dy": 6, "blur": 0}}},

  {"id": "drop_shadow", "name": "影だけ（縁なし）", "category": "シネマ", "tags": ["影", "控えめ"],
   "fonts": ["BIZ UDGothic", "Noto Sans JP", "Yu Gothic"],
   "palettes": ["white", "yellow", "gold", "silver", "cyan"],
   "style": {"size": 88, "weight": 700, "color": "$fill", "strokes": [],
